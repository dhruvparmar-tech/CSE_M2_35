# ==================================================
# AI Interview Platform - Environment Variables
# ==================================================

# Gemini API Key (REQUIRED for real AI mode)
# Get your FREE key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Database URL (PostgreSQL) — optional; leave blank to use in-memory DB
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# DATABASE_URL=postgresql://postgres:password@localhost:5432/ai_interview_platform

# JWT Secret (change this to a strong random string)
JWT_SECRET=your_secure_jwt_secret_change_this_in_production

# Server Port (use 5001 on newer Macs — macOS owns port 5000)
PORT=5001

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# AI Mode
# true  = use built-in mock AI (no API key needed, great for development)
# false = use real Gemini AI (requires GEMINI_API_KEY above)
USE_MOCK_AI=true

# Node Environment
NODE_ENV=development
